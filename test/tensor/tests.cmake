# Compile the emitted products, then compare with an independent dense oracle.
find_package(OpenMP REQUIRED COMPONENTS Fortran)
add_executable(generate_tensor test/tensor/generate_tensor.f90)
target_link_libraries(generate_tensor PRIVATE fortgen)
foreach(bits 32 64)
    set(tensor_uses "")
    set(tensor_cases "")
    set(tensor_sources "")
    set(cuda_includes "")
    set(cuda_cases "")
    set(cuda_sources "")
    set(case_id 0)
    foreach(d 2 3)
        foreach(p RANGE 1 8)
            foreach(extra 0 1)
                foreach(tables 0 1)
                    math(EXPR case_id "${case_id}+1")
                    set(name tensor_${d}_${p}_${extra}_${tables}_${bits})
                    set(product ${CMAKE_CURRENT_BINARY_DIR}/${name}.f90)
                    add_custom_command(OUTPUT ${product}
                        COMMAND generate_tensor fortran ${product}
                            ${d} ${p} ${extra} ${tables} ${bits} ${name}
                        DEPENDS generate_tensor VERBATIM)
                    list(APPEND tensor_sources ${product})
                    string(APPEND tensor_uses "    use ${name}_module, only: ${name}\n")
                    string(APPEND tensor_cases "        case (${case_id})\n"
                        "            call ${name}(nc, u, b, db, coef, y)\n")
                    if(FORTGEN_BUILD_CUDA_TESTING)
                        set(header ${CMAKE_CURRENT_BINARY_DIR}/${name}.cuh)
                        add_custom_command(OUTPUT ${header}
                            COMMAND generate_tensor cuda ${header}
                                ${d} ${p} ${extra} ${tables} ${bits} ${name}
                            DEPENDS generate_tensor VERBATIM)
                        list(APPEND cuda_sources ${header})
                        string(APPEND cuda_includes "#include \"${name}.cuh\"\n")
                        string(APPEND cuda_cases "case ${case_id}: ${name}<<<nc,nt>>>(nc,u,b,db,coef,y); break;\n")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endforeach()
    set(rk real${bits})
    set(tol 1.0e-14)
    if(bits EQUAL 32)
        set(tol 1.0e-6)
    endif()
    configure_file(test/tensor/test_tensor.f90.in tensor_test_${bits}.f90 @ONLY)
    add_executable(test_tensor_${bits} ${CMAKE_CURRENT_BINARY_DIR}/tensor_test_${bits}.f90
        ${tensor_sources})
    target_link_libraries(test_tensor_${bits} PRIVATE OpenMP::OpenMP_Fortran)
    add_test(NAME tensor_${bits} COMMAND test_tensor_${bits})
    set_tests_properties(tensor_${bits} PROPERTIES ENVIRONMENT "OMP_NUM_THREADS=4")
    if(FORTGEN_BUILD_CUDA_TESTING)
        set(ctype double)
        if(bits EQUAL 32)
            set(ctype float)
        endif()
        configure_file(test/tensor/test_tensor.cu.in tensor_test_${bits}.cu @ONLY)
        add_executable(test_cuda_tensor_${bits}
            ${CMAKE_CURRENT_BINARY_DIR}/tensor_test_${bits}.cu ${cuda_sources})
        target_include_directories(test_cuda_tensor_${bits} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
        set_target_properties(test_cuda_tensor_${bits} PROPERTIES
            CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON)
        add_test(NAME cuda_tensor_${bits} COMMAND test_cuda_tensor_${bits})
    endif()
endforeach()
