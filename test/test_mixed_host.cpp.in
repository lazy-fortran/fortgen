#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#define __device__
#define __forceinline__ inline
#include "mixed_correction.cuh"
#ifndef MIXED_EXEC
#define MIXED_EXEC mixed_correction
#endif

static void require(bool value) {
    if (!value) { std::cerr << "mixed precision oracle mismatch\n"; std::exit(1); }
}

int main() {
    std::size_t improved = 0;
    std::size_t cases = 0;
    for (std::int64_t m = -8; m <= 8; ++m) {
        for (std::int64_t n = -8; n <= 8; ++n) {
            const std::int64_t a = (std::int64_t(1) << 24) + m;
            const std::int64_t b = (std::int64_t(1) << 24) + n;
            const double x = std::ldexp(double(a), -24);
            const double y = std::ldexp(double(b), -24);
            // Integer multiplication fixes the exact real product independently.
            const double exact = std::ldexp(double(a * b), -48);
            float bulk;
            double residual, corrected, half, literal, large, rounded_x;
            bool valid;
            MIXED_EXEC(x, y, &bulk, &residual, &corrected, &half, &literal,
                &large, &valid, &rounded_x);
            require(corrected == exact && half == exact / 2.0);
            require(residual == exact - double(bulk));
            require(literal == 1099511627777.0 && large == 1.0e100);
            require(valid && rounded_x == double(float(x)));
            const volatile float bx = float(x), by = float(y);
            require(bulk == float(bx * by));
            if (double(bulk) != exact) ++improved;
            ++cases;
        }
    }
    float bulk;
    double residual, corrected, half, literal, large, rounded_x;
    bool valid;
    MIXED_EXEC(-1.0, 1.0, &bulk, &residual, &corrected, &half, &literal,
        &large, &valid, &rounded_x);
    require(!valid && corrected == 0.0 && half == -0.5);
    require(improved > 0);
    std::cout << "mixed precision oracle: " << cases << " exact corrections; "
        << improved << " differ from widened FP32 bulk\n";
}
