/* Runs one emitted tile kernel (TILE_NAME, TILE_MR x TILE_NR) against a
   direct sum for several k, including k = 0 and every unroll remainder. With
   TILE_UPDATE_C the kernel adds the tile to C (leading dimension MR + 3) and
   must leave the padding rows alone.
   Exit 77 (skipped) when the CPU lacks the kernel's instruction set. */
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

#if defined(TILE_A_STRIDED)
void TILE_NAME(int64_t k, const double *a, int64_t lda, const double *b, double *c, int64_t ldc);
#elif defined(TILE_B_STRIDED)
void TILE_NAME(int64_t k, const double *a, const double *b, int64_t ldb, double *c, int64_t ldc);
#elif defined(TILE_UPDATE_C)
void TILE_NAME(int64_t k, const double *a, const double *b, double *c, int64_t ldc);
#else
void TILE_NAME(int64_t k, const double *a, const double *b, double *acc);
#endif

#if defined(TILE_NEEDS_AMX)
#include <setjmp.h>
#include <signal.h>
static sigjmp_buf amx_jump;
static void amx_missing(int sig) {
    (void)sig;
    siglongjmp(amx_jump, 1);
}
/* enable and disable AMX once; SIGILL where the coprocessor is absent */
static int amx_present(void) {
    struct sigaction catch_ill, previous;
    int present = 0;
    catch_ill.sa_handler = amx_missing;
    catch_ill.sa_flags = 0;
    sigemptyset(&catch_ill.sa_mask);
    sigaction(SIGILL, &catch_ill, &previous);
    if (!sigsetjmp(amx_jump, 1)) {
        __asm__ volatile("nop\nnop\nnop\n.word 0x201220\nnop\nnop\nnop\n.word 0x201221" ::: "memory");
        present = 1;
    }
    sigaction(SIGILL, &previous, NULL);
    return present;
}
#endif

static int supported(void) {
#if defined(TILE_NEEDS_AMX)
    return amx_present();
#elif defined(TILE_NEEDS_AVX512)
    return __builtin_cpu_supports("avx512f");
#elif defined(TILE_NEEDS_AVX2)
    return __builtin_cpu_supports("avx2") && __builtin_cpu_supports("fma");
#else
    return 1;
#endif
}

int main(void) {
    enum { MR = TILE_MR, NR = TILE_NR };
    const int ks[] = {0, 1, 2, 3, 4, 5, 7, 8, 9, 64, 257};
    if (!supported()) {
        puts("instruction set not available; skipped");
        return 77;
    }
    for (unsigned c = 0; c < sizeof ks / sizeof *ks; c++) {
        const int k = ks[c];
#if defined(TILE_A_STRIDED)
        enum { LDA = MR + 5 };
#else
        enum { LDA = MR };
#endif
        double *a = malloc((size_t)LDA * (k + 1) * sizeof *a);
#if defined(TILE_B_STRIDED)
        const int ldb = k + 3;
#define BAT(p, j) b[(p) + ldb * (j)]
#else
#define BAT(p, j) b[(j) + NR * (p)]
#endif
        double *b = malloc((size_t)NR * (k + 4) * sizeof *b);
        double acc[MR * NR], ref[MR * NR] = {0}, scale[MR * NR] = {0};
        for (int i = 0; i < LDA * k; i++) a[i] = sin(1.0 + i);
        for (int j = 0; j < NR; j++)
            for (int p = 0; p < k; p++) BAT(p, j) = cos(2.0 + 3 * (j + NR * p));
        for (int p = 0; p < k; p++)
            for (int j = 0; j < NR; j++)
                for (int i = 0; i < MR; i++) {
                    ref[i + MR * j] += a[i + LDA * p] * BAT(p, j);
                    scale[i + MR * j] += fabs(a[i + LDA * p] * BAT(p, j));
                }
#if defined(TILE_UPDATE_C)
        enum { LDC = MR + 3 };
        double c[LDC * NR];
        for (int j = 0; j < NR; j++)
            for (int i = 0; i < LDC; i++) c[i + LDC * j] = 0.25 * i - 0.5 * j;
        for (int j = 0; j < NR; j++)
            for (int i = 0; i < MR; i++) {
                ref[i + MR * j] += c[i + LDC * j];
                scale[i + MR * j] += fabs(c[i + LDC * j]);
            }
#if defined(TILE_A_STRIDED)
        TILE_NAME(k, a, LDA, b, c, LDC);
#elif defined(TILE_B_STRIDED)
        TILE_NAME(k, a, b, ldb, c, LDC);
#else
        TILE_NAME(k, a, b, c, LDC);
#endif
        for (int j = 0; j < NR; j++) {
            for (int i = 0; i < MR; i++) acc[i + MR * j] = c[i + LDC * j];
            for (int i = MR; i < LDC; i++)
                if (c[i + LDC * j] != 0.25 * i - 0.5 * j) {
                    printf("k = %d: padding row %d of column %d changed\n", k, i, j);
                    return 1;
                }
        }
#else
        for (int i = 0; i < MR * NR; i++) acc[i] = NAN;
        TILE_NAME(k, a, b, acc);
#endif
        for (int i = 0; i < MR * NR; i++) {
            /* both sums round differently; bound by k ulp of the absolute sum */
            if (!(fabs(acc[i] - ref[i]) <= 4.0 * (k + 1) * 1.2e-16 * scale[i])) {
                printf("k = %d, element %d: %.17g, expected %.17g\n", k, i, acc[i], ref[i]);
                return 1;
            }
        }
        free(a);
        free(b);
    }
    puts("tile kernel matches the direct sum");
    return 0;
}
